<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.sangdaeng001sqlbank.dao.hyepin.ProblemDao">
    <!-- 문제 목록 조회 (페이징, 검색 기능 포함) -->
    <select id="getProblemList" resultType="com.example.sangdaeng001sqlbank.dto.ProblemDto">
        SELECT p.*, u.name AS createdByName, u.class_num AS classNum
        FROM tbl_problems p
        JOIN tbl_users u ON p.user_id = u.user_id
        <where>
            <if test="type != null and keyword != null">
                <choose>
                    <when test='type.toString() == "id"'>
                        <if test="keyword != null and keyword != ''">
                            p.problem_id = #{keyword}
                        </if>
                    </when>
                    <when test='type.toString() == "Q"'>
                        p.question LIKE CONCAT('%', #{keyword}, '%')
                    </when>
                    <when test='type.toString() == "A"'>
                        u.name LIKE CONCAT('%', #{keyword}, '%')
                    </when>
                </choose>
            </if>
        </where>
        ORDER BY p.problem_id DESC
        LIMIT #{size} OFFSET #{offset}
    </select>

    <!-- 총 문제 개수 조회 (검색 조건 포함) -->
    <select id="getProblemCount" resultType="int">
        SELECT COUNT(*)
        FROM tbl_problems p
        JOIN tbl_users u ON p.user_id = u.user_id
        <where>
            <if test="type != null and keyword != null">
                <choose>
                    <when test='type.toString() == "id"'>
                        <if test="keyword != null and keyword != ''">
                            p.problem_id = #{keyword}
                        </if>
                    </when>
                    <when test='type.toString() == "Q"'>
                        p.question LIKE CONCAT('%', #{keyword}, '%')
                    </when>
                    <when test='type.toString() == "A"'>
                        u.name LIKE CONCAT('%', #{keyword}, '%')
                    </when>
                </choose>
            </if>
        </where>
    </select>

    <!-- 문제 상세 조회 -->
    <select id="getProblemDetail" resultType="com.example.sangdaeng001sqlbank.dto.ProblemDto">
        SELECT
        p.*,
        u.name AS createdByName,
        u.class_num AS classNum,
        (SELECT choice_text
        FROM tbl_problem_choices
        WHERE problem_id = p.problem_id
        AND is_correct = 1
        LIMIT 1) AS answer
        FROM tbl_problems p
        JOIN tbl_users u ON p.user_id = u.user_id
        WHERE p.problem_id = #{problemId}
    </select>
</mapper>