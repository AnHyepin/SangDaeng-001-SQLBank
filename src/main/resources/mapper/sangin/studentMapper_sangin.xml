<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.sangdaeng001sqlbank.dao.sangin.StudentDao_sangin">
    <select id="getProblemsByDifficulty" resultType="com.example.sangdaeng001sqlbank.dto.ProblemDto">
        SELECT *
        FROM tbl_problems
        WHERE difficulty = #{difficulty}
        ORDER BY RAND() LIMIT 10
    </select>
    <select id="getProblemChoicesByDifficulty" resultType="com.example.sangdaeng001sqlbank.dto.ProblemChoiceDto">
        select *
        from tbl_problem_choices
        where problem_id = #{problemId}
    </select>
</mapper>